# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Embedding backend: "openai" or "local"
EMBEDDING_BACKEND=openai

# Retrieval
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K=5

# Reliability
CONFIDENCE_THRESHOLD=0.6

# Paths
CHROMA_DB_PATH=data/chroma_db
LOG_DIR=data/logs

# Neo4j (GraphRAG)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j
NEO4J_DATABASE=neo4j

# GraphRAG behavior
USE_GRAPH_RAG=true
GRAPH_RAG_MODE=auto          # off | auto | local | global | both
COMMUNITY_LEVELS=3
GRAPH_LOCAL_TOPK=5
GRAPH_LOCAL_HOPS=2
GRAPH_GLOBAL_TOP_COMMUNITIES=5
GRAPH_REBUILD_THRESHOLD=100  # entities added before triggering new community pass
